# 数据管理系统环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# DeepSeek API配置（必需）
DATASET_MANAGER_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 服务器配置
DATASET_MANAGER_DEBUG=true
DATASET_MANAGER_HOST=127.0.0.1
DATASET_MANAGER_PORT=8000

# 目录配置
DATASET_MANAGER_UPLOAD_DIR=./uploads
DATASET_MANAGER_METADATA_DIR=./metadata
DATASET_MANAGER_LOGS_DIR=./logs

# 文件处理配置
DATASET_MANAGER_MAX_FILE_SIZE=104857600  # 100MB
DATASET_MANAGER_SAMPLE_ROWS=1000
DATASET_MANAGER_PREVIEW_ROWS=10

# DeepSeek API配置
DATASET_MANAGER_DEEPSEEK_BASE_URL=https://api.deepseek.com 
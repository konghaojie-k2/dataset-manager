# ====================================
# Dataset Manager 环境变量配置
# ====================================

# 基础配置
DATASET_MANAGER_DEBUG=false
DATASET_MANAGER_HOST=0.0.0.0
DATASET_MANAGER_PORT=8003

# 目录配置（使用Supabase后，这些配置主要用于本地缓存）
DATASET_MANAGER_UPLOAD_DIR=uploads
DATASET_MANAGER_METADATA_DIR=metadata
DATASET_MANAGER_LOGS_DIR=logs

# LLM配置
DATASET_MANAGER_DEEPSEEK_API_KEY=your_deepseek_api_key_here
DATASET_MANAGER_DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM模型配置
DATASET_MANAGER_REASONING_MODEL=deepseek-chat
DATASET_MANAGER_BASIC_MODEL=deepseek-chat
DATASET_MANAGER_VISION_MODEL=deepseek-chat

# LLM参数配置
DATASET_MANAGER_LLM_TEMPERATURE=0.1
DATASET_MANAGER_LLM_MAX_TOKENS=4000

# 文件处理配置
DATASET_MANAGER_MAX_FILE_SIZE=104857600
DATASET_MANAGER_SAMPLE_ROWS=1000
DATASET_MANAGER_PREVIEW_ROWS=10

# 版本控制配置
DATASET_MANAGER_VERSION_CONTROL_ENABLED=true
DATASET_MANAGER_DUPLICATE_DETECTION_ENABLED=true
DATASET_MANAGER_DUPLICATE_STORAGE_STRATEGY=reject
DATASET_MANAGER_AUTO_CLEANUP_ENABLED=true
DATASET_MANAGER_DEFAULT_KEEP_VERSIONS=5

# ====================================
# Supabase配置（使用Supabase存储时必需）
# ====================================

# Supabase项目URL - 在Supabase项目设置中获取
DATASET_MANAGER_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key - 在Supabase项目API设置中获取
DATASET_MANAGER_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key - 在Supabase项目API设置中获取（用于服务端操作）
DATASET_MANAGER_SUPABASE_SERVICE_KEY=your_service_role_key_here

# Supabase Storage配置
DATASET_MANAGER_STORAGE_BUCKET_NAME=dataset-files
DATASET_MANAGER_STORAGE_MAX_FILE_SIZE=104857600

# ====================================
# 配置说明
# ====================================

# 1. Supabase设置步骤：
#    - 在 https://supabase.com 创建新项目
#    - 在项目设置 > API 中获取 URL、Anon Key 和 Service Role Key
#    - 在 Storage 中创建一个名为 "dataset-files" 的公开存储桶
#    - 在 Database 中创建 "datasets" 表（见下面的SQL脚本）
#
# 2. datasets表结构（在Supabase SQL编辑器中执行）：
#
# CREATE TABLE datasets (
#     id TEXT PRIMARY KEY,
#     name TEXT NOT NULL,
#     description TEXT,
#     file_path TEXT NOT NULL,
#     file_size BIGINT,
#     row_count INTEGER,
#     column_count INTEGER,
#     column_names JSONB,
#     column_types JSONB,
#     industry TEXT,
#     tags TEXT[],
#     processing_status TEXT DEFAULT 'pending',
#     uploaded_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
#     last_modified TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
#     is_duplicate BOOLEAN DEFAULT FALSE,
#     parent_dataset_id TEXT,
#     version_number INTEGER DEFAULT 1,
#     storage_strategy TEXT DEFAULT 'full',
#     file_hash TEXT,
#     content_hash TEXT,
#     compression_info JSONB,
#     preview_data JSONB,
#     data_source TEXT,
#     data_quality_score FLOAT,
#     metadata_version TEXT DEFAULT '1.0',
#     device_time_identification JSONB,
#     business_meaning_analysis JSONB,
#     control_relationships_analysis JSONB,
#     basic_analysis JSONB,
#     detailed_analysis JSONB,
#     insights JSONB,
#     recommendations JSONB,
#     quality_analysis_results JSONB,
#     business_analysis_results JSONB
# );
#
# -- 创建索引
# CREATE INDEX idx_datasets_uploaded_at ON datasets(uploaded_at DESC);
# CREATE INDEX idx_datasets_industry ON datasets(industry);
# CREATE INDEX idx_datasets_status ON datasets(processing_status);
# CREATE INDEX idx_datasets_tags ON datasets USING GIN(tags);
#
# -- 启用RLS（可选，如果需要权限控制）
# ALTER TABLE datasets ENABLE ROW LEVEL SECURITY;
#
# -- 允许所有操作（开发环境）
# CREATE POLICY "Allow all access" ON datasets FOR ALL USING (true) WITH CHECK (true);
